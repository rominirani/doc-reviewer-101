# ============================================================================
# 1. Google Cloud & Vertex AI Configuration (Used by ADK & Developer Knowledge MCP)
# ============================================================================
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="global"
GOOGLE_CLOUD_PROJECT_NUMBER="your-gcp-project-number"

# Optional: Developer Knowledge MCP uses Application Default Credentials (ADC) by default.
# If you prefer to authenticate to https://developerknowledge.googleapis.com/mcp with an API Key, uncomment below:
# DEVELOPERKNOWLEDGE_API_KEY="AIzaSy-your-developer-knowledge-api-key"

# ============================================================================
# 2. Google OAuth 2.0 Web Client (Used for Personal Google Account Sign-In)
# Create at: https://console.cloud.google.com/apis/credentials
# ============================================================================
OAUTH_CLIENT_ID="your-oauth-client-id.apps.googleusercontent.com"
OAUTH_CLIENT_SECRET="GOCSPX-your-oauth-client-secret"

# Keep OAUTH_REDIRECT_URI set for local development.
# When deployed to Cloud Run, omit this variable so the app auto-detects its https://*.run.app/auth/callback URL.
OAUTH_REDIRECT_URI="http://localhost:8000/auth/callback"

# ============================================================================
# 3. Google Drive Picker Browser API Key
# Requires "Google Picker API" (picker.googleapis.com) enabled in your project
# ============================================================================
GOOGLE_PICKER_API_KEY="AIzaSy-your-browser-api-key"
